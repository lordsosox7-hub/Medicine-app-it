{
  "expo": {
    "name": "بوابة الطبيب",
    "slug": "gkm-doctor-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doctor-admin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e6bf0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gkm.doctoradmin",
      "infoPlist": {
        "NSCameraUsageDescription": "مطلوب الوصول للكاميرا لمسح رموز QR الخاصة بمواعيد المرضى"
      }
    },
    "android": {
      "package": "com.gkm.doctoradmin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1e6bf0"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "مطلوب الوصول للكاميرا لمسح رموز QR الخاصة بمواعيد المرضى"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "gkm-doctor-admin"
      }
    }
  }
}
